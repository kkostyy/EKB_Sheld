# ВНИМАНИЕ: plugins/DiscordSRV/config.yml и CourtBridge/src/main/resources/config.yml
# в репозитории хранятся ТОЛЬКО с заглушками. Перед коммитом убедись, что
# реальный BotToken/Webhook туда не попал — боевые значения держи на сервере.

# ============================================================================
# РАЗВЁРНУТЫЙ СЕРВЕР — не версионируется вообще.
#
# server/ это не исходник, а результат: его раскладывает setup.ps1 из этого
# же репозитория. Уникального там ничего нет — скрипты Skript, датапак и
# конфиги лежат копиями. Зато есть то, чему в публичном репозитории не место:
#   server/server.properties            — боевой пароль RCON
#   server/plugins/DiscordSRV/config.yml — боевой токен бота
#   server/plugins/AuthMe/authme.db      — хеши паролей игроков
#   server/plugins/LuckPerms/*.mv.db     — база прав
#   server/world*/                       — мир и логи на сотни мегабайт
# 18.09.2026 всё это уже лежало в индексе git — 2279 файлов.
# ============================================================================
server/

# Секреты, которые повторяются в корне репозитория
backups/
*.log

# ключ MineSkin и журнал заливки скинов
skins/mineskin.key
skins/upload.log
skins/upload.err

# личный ключ OpenRouter — не коммитить
claude-via-openrouter.ps1
