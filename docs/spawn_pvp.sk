# EKB SHIELD — spawn_pvp.sk
# Главный город: свободного PvP нет, но заказ работает и здесь.
#
# Правило. Внутри Главного города (регион `spawn`) ударить игрока можно
# только при условии, что на него есть АКТИВНЫЙ заказ (`contracts.sk`).
# Вне города PvP свободно, как и было.
#
# ⚠ Почему это Skript, а не флаг WorldGuard. У региона был `pvp: deny`, и он
# работает безусловно: исключений флаг не знает в принципе, а отменяет урон
# раньше любого скрипта. Поэтому флаг переведён в `allow`
# (`build_spawn_region.py`), и весь запрет ведёт этот файл — он единственный,
# кто знает про доску контрактов. Вернёшь `pvp: deny` — заказ в городе
# перестанет работать молча, и выглядеть это будет как «скрипт сломался».
#
# ⚠ Тетрадь Смерти сюда НЕ попадает, и это намеренно: `death_note.sk` бьёт
# командой `kill %victim%`, а не событием урона. Ни флаг WorldGuard, ни этот
# обработчик её не видят — Тетрадь работает в городе ровно так же, как за
# его пределами. Не вздумай «на всякий случай» закрыть здесь смерть целиком.
#
# ⚠ Зона проверяется у ОБОИХ. Иначе Главный город превращается в вышку:
# стоя внутри, можно расстреливать тех, кто снаружи, и оставаться
# неприкосновенным.
#
# ⚠ Утечка, которой не избежать при таком правиле: удар, который прошёл,
# сообщает нападающему, что заказ есть. Скрыть это нельзя — либо удар
# проходит, либо нет. Поэтому отказ сформулирован нейтрально, про город,
# и ничего не говорит про заказы: неудачная попытка не отличается от
# «здесь просто не дерутся».
#
# Зона читается функцией `tr_at_spawn` из `treasury.sk` — по СПИСКУ регионов
# в точке, а не литералом региона (разбор там же).
#
# Ставится в plugins/Skript/scripts/

options:
    prefix: &c&l[ГОРОД] &r
    line: &8&m----------------------------------------
    warn_gap: 3         # не чаще раза в N секунд повторять отказ

# Хранилище:
#   {sp::warn::<uuid>}  — когда последний раз объясняли отказ

function sp_warn(p: player, msg: text):
    set {_k} to "%uuid of {_p}%"
    set {_now} to unix timestamp of now
    set {_ok} to true
    if {sp::warn::%{_k}%} is set:
        if {sp::warn::%{_k}%} > {_now} - {@warn_gap}:
            set {_ok} to false
    if {_ok} is true:
        set {sp::warn::%{_k}%} to {_now}
        send "{@prefix}%{_msg}%" to {_p}

on damage:
    attacker is a player
    victim is a player
    set {_a} to attacker
    set {_v} to victim
    set {_here} to false
    if tr_at_spawn(location of {_v}) is true:
        set {_here} to true
    if tr_at_spawn(location of {_a}) is true:
        set {_here} to true
    if {_here} is true:
        # Единственное исключение — активный заказ на жертву. Проверка живёт
        # в contracts.sk и одна на весь проект.
        if ct_wanted("%{_v}%") is false:
            cancel event
            sp_warn({_a}, "&7В Главном городе не дерутся. Спор — в Суд.")
