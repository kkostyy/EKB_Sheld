# EKB SHIELD — spear_no_cooldown.sk
# Снимает перезарядку копий.
#
# Копья (деревянное, каменное, медное, железное, золотое, алмазное,
# незеритовое) появились в 26.1 и несут ванильный компонент
# `minecraft:use_cooldown`: после применения предмет уходит в откат,
# по иконке ползёт серая шторка. Датапаком это не лечится — датапак
# умеет добавлять свои предметы, но не переписывать дефолтные
# компоненты ванильных. Поэтому откат снимается на месте, через Bukkit.
#
# ⚠ Skript 2.16.2 копий не знает: в его алиасах нет ни одного «spear»,
# и литерал `iron spear` просто не разберётся. Поэтому тип нигде не
# записан — он берётся прямо из руки (`player's tool`), а опознаётся
# по имени материала, приведённому к нижнему регистру.
#
# Ставится в plugins/Skript/scripts/

# ---------------------------------------------------------------------------
# Снятие отката
# ---------------------------------------------------------------------------

function spear_is(i: item) :: boolean:
    if {_i} is air:
        return false
    if "%type of {_i}%" in lowercase contains "spear":
        return true
    return false

# Обе руки: копьё держат и во второй, а откат у него свой.
function spear_clear(p: player):
    set {_t} to {_p}'s tool
    if spear_is({_t}) is true:
        set item cooldown of {_t} for {_p} to 0 seconds
    set {_o} to off hand tool of {_p}
    if spear_is({_o}) is true:
        set item cooldown of {_o} for {_p} to 0 seconds

# ---------------------------------------------------------------------------
# Когда чистить
# ---------------------------------------------------------------------------

# Удар копьём — главный источник отката. Чистим и сразу, и через тик:
# ванильный откат ставится уже после обработки события.
on damage:
    attacker is a player
    spear_clear(attacker)
    wait 1 tick
    spear_clear(attacker)

on right click:
    spear_clear(player)
    wait 1 tick
    spear_clear(player)

# Подстраховка на случай, если откат пришёл не от этих двух событий
# (бросок, смена руки, выдача предмета уже в откате). Цикл дешёвый:
# внутри всё обрывается на первом же «в руке не копьё».
every 2 ticks:
    loop all players:
        spear_clear(loop-player)
