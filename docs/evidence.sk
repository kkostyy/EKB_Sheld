# EKB SHIELD — evidence.sk
# Криминалистическая экспертиза: место убийства -> имя убийцы для Суда.
# Требует docs/treasury.sk — процедура оплачивается в Казну Спавна.
#
# Что переделано против присланной спецификации.
#
# 1. В спецификации кнопка списывала 20💎 и печатала «(50% Шанс) Данные
#    отправлены в Суд Спавна» — никакого шанса там не было и никаких данных
#    тоже: сообщение просто врало. Здесь бросок настоящий, и раскрывать
#    экспертизе есть что: скрипт ведёт реестр убийств.
#
# 2. Экспертиза работает ПО МЕСТУ, а не по воздуху. Следователь приходит
#    туда, где лежало тело, и платит за осмотр этого места. Без привязки к
#    координате это была бы кнопка «узнать любого убийцу за 20💎».
#
# 3. Результат уходит не только игроку, но и в консоль (оттуда в Discord
#    Администрации): экспертиза — это доказательство для Суда, а не сплетня.
#    Само обвинение всё равно подаёт человек — /report или /иск в Discord.
#
# Как это сцеплено с остальным.
#   contracts.sk при каждом убийстве уже рассылает свидетелям в радиусе
#   48 блоков готовую команду /report. Свидетелей может не быть — тогда дела
#   нет вовсе (молчание свидетеля по УК ненаказуемо). Экспертиза — второй
#   путь к тому же: место преступления помнит убийцу трое суток.
#
# Хранилище:
#   {ev::id}                — счётчик происшествий
#   {ev::killer::<id>}      — ник убийцы
#   {ev::victim::<id>}      — ник жертвы
#   {ev::loc::<id>}         — координата тела
#   {ev::when::<id>}        — unix-время
#   {ev::solved::<id>}      — экспертиза уже проводилась
#   {ev::wit::<id>::*}      — кто был в радиусе в момент убийства
#   {ev::seen::<uuid>}      — последнее происшествие, которое видел игрок
#
# Команды:
#   /expertise        — осмотреть место, где стоишь (20💎)
#   /crimescenes      — открытые происшествия (Суд и Администрация)
#   /witness          — дать показания головами по тому, что видел

options:
    prefix: &9&l[ЭКСПЕРТИЗА] &r
    admin: coreprotect.rollback
    detective: ekb.duty.detective
    price: 20
    radius: 12           # блоков от тела, где ещё есть что осматривать
    keep_hours: 72       # через трое суток след остывает
    chance: 50           # процент успеха
    witness: 48          # радиус свидетелей — тот же, что в contracts.sk

# ---------------------------------------------------------------------------
# Реестр убийств
# ---------------------------------------------------------------------------

# Отдельное `on death of player` в другом скрипте конфликта не даёт: Skript
# зовёт все обработчики события. contracts.sk на том же событии считает
# выполнение контракта, здесь — только следы.
#
# Записываем ТОЛЬКО убийство игроком. Смерть от падения, мобов и лавы
# экспертизе не интересна: судить некого.
on death of player:
    attacker is a player
    victim is a player
    if attacker is victim:
        stop
    add 1 to {ev::id}
    set {_id} to "%{ev::id}%"
    set {ev::killer::%{_id}%} to "%attacker%"
    set {ev::victim::%{_id}%} to "%victim%"
    set {ev::loc::%{_id}%} to location of victim
    set {ev::when::%{_id}%} to unix timestamp of now

    # Список свидетелей снимается ПРЯМО СЕЙЧАС: через минуту все разойдутся,
    # и восстановить, кто стоял рядом, будет уже нечем. contracts.sk на том
    # же событии рассылает им уведомление с готовым /report — здесь тот же
    # круг людей запоминается, чтобы показания можно было дать кликом.
    set {_dead} to "%victim%"
    set {_kname} to "%attacker%"
    loop players in radius {@witness} around victim:
        if "%loop-player%" is not {_dead}:
            if "%loop-player%" is not {_kname}:
                add "%loop-player%" to {ev::wit::%{_id}%::*}
                set {ev::seen::%uuid of loop-player%} to {_id}

# ---------------------------------------------------------------------------
# Показания головами
# ---------------------------------------------------------------------------
#
# Зачем окно. До 24.09.2026 свидетель получал в чат строку «Показания в Суд:
# /report <ник>» и должен был набрать ник руками — а ники на этом сервере
# бывают такие, что с первого раза не наберёшь. Здесь тот же круг людей,
# но головами: клик = показание.
#
# ⚠ Окно открывает ТОЛЬКО тот, кто действительно был на месте: происшествие
# берётся из {ev::seen::<uuid>}, куда игрок попал в момент убийства. Иначе
# это был бы список всех убийств на сервере, то есть готовая сводка для
# того, кто хочет знать, где и кого убивают.
#
# ⚠ Показание не обвиняет автоматически: /report у AdvancedReports только
# открывает своё окно и спрашивает причину. Молчание свидетеля по УК 5.3
# ненаказуемо, поэтому в окне есть «промолчать».
#
# CMD 7920-7922 — свободный диапазон (7900 у найма, 7910 у стройки).
function ev_cmd(i: item) :: number:
    if {_i} is air:
        return 0
    return custom model data of {_i}

function ev_witness(p: player):
    set {_u} to "%uuid of {_p}%"
    set {_id} to {ev::seen::%{_u}%}
    if {_id} is not set:
        send "{@prefix}&7Ты ничего не видел — показания давать не о чем." to {_p}
    else if ev_fresh({_id}) is false:
        send "{@prefix}&7След по тому делу остыл: прошло больше {@keep_hours} ч." to {_p}
        delete {ev::seen::%{_u}%}
    else:
        set {_inv} to a chest inventory with 3 rows named "&8Показания по делу №%{_id}%"
        set {_f} to 1 of gray stained glass pane
        set custom model data of {_f} to 7920
        set name of {_f} to " "
        loop 0, 1, 2, 3, 5, 6, 7, 8, 9, 17, 18, 19, 20, 21, 23, 24, 25 and 26:
            set slot loop-value of {_inv} to {_f}

        set {_l} to {ev::loc::%{_id}%}
        set {_v} to 1 of player head
        set skull owner of {_v} to {ev::victim::%{_id}%} parsed as offline player
        set custom model data of {_v} to 7920
        set name of {_v} to "&c&lУбит: %{ev::victim::%{_id}%}%"
        set lore of {_v} to "&7X %floor(x coordinate of {_l})%, Y %floor(y coordinate of {_l})%, Z %floor(z coordinate of {_l})%" and "&8Дело №%{_id}%"
        set slot 4 of {_inv} to {_v}

        # Первым — тот, кого ты видел с оружием. Остальные свидетели рядом:
        # свидетель мог ошибиться, и обвинить он вправе любого из бывших там.
        set {_names::*} to {ev::killer::%{_id}%}
        loop {ev::wit::%{_id}%::*}:
            if loop-value is not "%{_p}%":
                add loop-value to {_names::*}
        set {_slots::*} to 10, 11, 12, 13, 14, 15 and 16
        set {_n} to 0
        loop {_names::*}:
            if {_n} < 7:
                add 1 to {_n}
                set {_h} to 1 of player head
                set skull owner of {_h} to loop-value parsed as offline player
                set custom model data of {_h} to 7921
                if {_n} is 1:
                    set name of {_h} to "&c%loop-value%"
                    set lore of {_h} to "&7Его ты видел с оружием." and "&aКлик — подать показания"
                else:
                    set name of {_h} to "&7%loop-value%"
                    set lore of {_h} to "&8Тоже был рядом." and "&aКлик — подать показания"
                set slot ({_slots::%{_n}%}) of {_inv} to {_h}

        set {_q} to 1 of barrier
        set custom model data of {_q} to 7922
        set name of {_q} to "&8&lПромолчать"
        set lore of {_q} to "&7Молчание свидетеля ненаказуемо." and "&8УК 5.3"
        set slot 22 of {_inv} to {_q}
        open {_inv} to {_p}

on inventory click:
    event-item is not air
    set {_c} to ev_cmd(event-item)
    if {_c} is between 7920 and 7922:
        cancel event
        set {_nick} to uncoloured (name of event-item)
        set {_me} to player
        set {_u} to "%uuid of player%"
        if {_c} is 7922:
            close player's inventory
            delete {ev::seen::%{_u}%}
            send "{@prefix}&7Ты промолчал. Это право свидетеля (УК 5.3)." to {_me}
        else if {_c} is 7921:
            close player's inventory
            delete {ev::seen::%{_u}%}
            # Причину спросит своим окном сам AdvancedReports: команда берёт
            # только ник, второй аргумент плагин выбрасывает молча.
            make {_me} execute command "report %{_nick}%"
            send "{@prefix}&7Показания по &f%{_nick}%&7 поданы." to {_me}
            send "[ЭКСПЕРТИЗА] %{_me}% дал показания на %{_nick}%" to console

command /witness:
    description: Дать показания по убийству, которое ты видел
    usage: /witness
    aliases: /показания
    executable by: players
    trigger:
        ev_witness(player)

function ev_fresh(id: text) :: boolean:
    if {ev::killer::%{_id}%} is not set:
        return false
    if {ev::solved::%{_id}%} is true:
        return false
    if ((unix timestamp of now) - {ev::when::%{_id}%}) > ({@keep_hours} * 3600):
        return false
    return true

# ---------------------------------------------------------------------------
# Осмотр места
# ---------------------------------------------------------------------------

command /expertise:
    description: Криминалистический осмотр места, где ты стоишь (20 алмазов)
    aliases: /экспертиза
    executable by: players
    trigger:
        # Сначала ищем, есть ли что осматривать. Брать деньги за осмотр
        # чистого поля — это не «шанс 50%», это обман.
        set {_best} to ""
        set {_bestwhen} to 0
        loop {ev::killer::*}:
            set {_id} to loop-index
            if ev_fresh({_id}) is true:
                set {_l} to {ev::loc::%{_id}%}
                if world of {_l} is world of player:
                    if distance between {_l} and location of player <= {@radius}:
                        if {ev::when::%{_id}%} > {_bestwhen}:
                            set {_bestwhen} to {ev::when::%{_id}%}
                            set {_best} to {_id}

        if {_best} is "":
            send "{@prefix}&7Здесь ничего нет: в радиусе {@radius} блоков никто не погибал от чужой руки"
            send "{@prefix}&7за последние {@keep_hours} часа, либо место уже осматривали."
            send "{@prefix}&8Деньги за пустой осмотр не берут."
            stop

        set {_r} to tr_pay(player, {@price})
        if {_r} is not "ok":
            send "{@prefix}%{_r}%"
            send "{@prefix}&7Процедура стоит &b{@price}💎&7 и идёт в Казну Спавна."
            stop

        # Место осмотрено в любом случае — и при удаче, и при провале.
        # Иначе экспертизу крутили бы по кругу, пока не выпадет успех.
        set {ev::solved::%{_best}%} to true
        set {_victim} to {ev::victim::%{_best}%}
        set {_killer} to {ev::killer::%{_best}%}
        set {_ago} to floor(((unix timestamp of now) - {ev::when::%{_best}%}) / 3600)

        send "{@prefix}&7Осмотр места... жертва: &f%{_victim}%&7, примерно &f%{_ago}%&7 ч. назад."
        play sound "block.brewing_stand.brew" with volume 0.8 to player
        wait 2 seconds

        if (random integer between 1 and 100) <= {@chance}:
            send "{@prefix}&a&lСЛЕД ВЗЯТ. &fУбийца: &c%{_killer}%"
            send "{@prefix}&7Заключение передано Суду. Обвинение подаёшь ты:"
            send "{@prefix}&b/report %{_killer}%&7 или иск в Discord."
            send "&7 Причину и подробности спросит окно жалобы."
            send "[ЭКСПЕРТИЗА] %player% установил: %{_killer}% убил %{_victim}% (дело %{_best}%)" to console
        else:
            send "{@prefix}&cСлед потерян. &7Следы затоптаны, заключение пустое."
            send "{@prefix}&7Место осмотрено и повторно ничего не даст. &b{@price}💎&7 ушли в Казну."
            send "[ЭКСПЕРТИЗА] %player% осмотрел место гибели %{_victim}% — безрезультатно (дело %{_best}%)" to console

command /crimescenes:
    description: Открытые происшествия, которые ещё можно осмотреть
    aliases: /происшествия
    trigger:
        # Список открытых дел — рабочий инструмент следователя, а не
        # админская диагностика. Убийца в нём всё равно не показан.
        set {_ok} to false
        if sender has permission "{@admin}":
            set {_ok} to true
        if sender has permission "{@detective}":
            set {_ok} to true
        if {_ok} is false:
            send "{@prefix}&cСписок происшествий ведут Суд и следователь." to sender
            stop
        set {_n} to 0
        send "{@prefix}&7Открытые происшествия (след живёт {@keep_hours} ч.):"
        # Перебор по реестру убийц: у ветки {ev::<id>} собственного значения
        # нет, и `loop {ev::*}` вернул бы пусто — та же грабля, из-за которой
        # /jailitems list рапортовал о пустом ящике.
        loop {ev::killer::*}:
            set {_id} to loop-index
            if ev_fresh({_id}) is true:
                add 1 to {_n}
                set {_l} to {ev::loc::%{_id}%}
                set {_ago} to floor(((unix timestamp of now) - {ev::when::%{_id}%}) / 3600)
                send "&8 №&f%{_id}%&8 · жертва &f%{ev::victim::%{_id}%}%&8 · %{_ago}% ч. назад · &7%floor(x coordinate of {_l})%, %floor(y coordinate of {_l})%, %floor(z coordinate of {_l})%"
        if {_n} <= 0:
            send "&7Открытых происшествий нет."
        else:
            send "&8Убийца в списке не показан намеренно: его должна назвать экспертиза,"
            send "&8иначе Суд получал бы готовые ответы в обход процедуры."
