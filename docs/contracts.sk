# EKB SHIELD — contracts.sk
# Контракты на устранение: тёмная сторона экономики.
#
# Правило, ради которого всё затевалось: самосуд запрещён. Убить можно
# либо защищаясь, либо исполняя контракт — и то и другое разбирает Суд,
# если найдётся свидетель. Контракт не делает убийство законным: он даёт
# мотив, цену и след, по которому Суд выходит на заказчика.
#
# Как устроено:
#   — заказчик платит вперёд: алмазы списываются из инвентаря и лежат
#     в депозите, пока контракт открыт (иначе «заказы» были бы бесплатными
#     и доска утонула бы в мусоре);
#   — исполнитель берёт контракт; после гибели цели он получает не алмазы,
#     а ГОЛОВУ жертвы (доказательство) и несёт её заказчику. Депозит
#     переходит исполнителю только в руки заказчика — так у сделки есть
#     физический след, а не «умер где-то — деньги упали с неба»;
#   — заказчик может отозвать контракт и забрать алмазы, пока его никто
#     не выполнил;
#   — у убийства всегда есть свидетели: все, кто был в радиусе {@witness}
#     блоков, получают уведомление и могут подать иск.
#
# Ставится в plugins/Skript/scripts/

options:
    prefix: &4&l[КОНТРАКТ] &r
    line: &8&m----------------------------------------
    witness: 48         # радиус, в котором убийство считается замеченным
    minprice: 16        # минимальная награда, алмазов
    expire: 604800      # контракт живёт неделю реального времени
    repeat: 86400       # после исполнения ту же цель не заказывают сутки
    head_cmd: 7810      # метка «головы-доказательства» (CustomModelData)
    deliver_radius: 6   # на каком расстоянии можно передать голову заказчику
    mail_price: 4       # марка анонимной посылки с головой — как обычная посылка
    admin: coreprotect.rollback

# Хранилище:
#   {ct::id}                  — счётчик
#   {ct::target::%id%}        — ник цели
#   {ct::owner::%id%}         — ник заказчика
#   {ct::price::%id%}         — алмазов в депозите
#   {ct::taker::%id%}         — кто взял
#   {ct::made::%id%}          — когда создан (unix)
#   {ct::done::%id%}          — цель мертва, ждёт передачи головы (ник исполнителя)
#   {ct::last::%ник в нижнем регистре%} — когда цель последний раз убита по контракту
#   {ct::mailed::%id%}        — голова уехала почтой, ждёт вручения (номер отправления)
#   {ct::owe::%ник%}          — награда исполнителю, который был не в сети при вручении
#
# Голову заказчику доставляют ДВУМЯ путями, и оба анонимны:
#   — лично: ПКМ по заказчику. Исполнитель при этом ВСЕГДА в Личине
#     (shadow.sk): не надел сам — наденется при первом клике, передать
#     можно вторым. Ник над головой TAB не прячет (разбор в shadow.sk),
#     но скин и таб-лист — уже чужие;
#   — почтой: /contract mail. Адрес заказчика почта берёт из контракта
#     (исполнитель его так и не узнаёт), в отправителе — псевдоним.
#     Расчёт происходит в момент ВРУЧЕНИЯ, а не отправки: пока голова в
#     пути, Суд может аннулировать контракт, и тогда она придёт трофеем.

# ---------------------------------------------------------------------------
# Служебное
# ---------------------------------------------------------------------------

function ct_open(id: text) :: boolean:
    if {ct::target::%{_id}%} is not set:
        return false
    return true

# Есть ли на игроке ХОТЯ БЫ один незакрытый заказ.
#
# Единая точка правды на весь проект: на неё завязаны и наём кочевников
# (`hire.sk` — нанять человека под заказом нельзя, иначе наём за 16💎 снимал
# бы контракт на 256💎), и PvP Главного города (`spawn_pvp.sk` — в безопасной
# зоне бьют только того, на кого есть заказ).
#
# ⚠ Контракт со снятой головой (`ct::done`) уже исполнен: цель мертва, идёт
# расчёт. Считать его активным значит держать человека мишенью после того,
# как по нему отработали.
function ct_wanted(name: text) :: boolean:
    set {_w} to false
    loop {ct::target::*}:
        if loop-value is {_name}:
            if {ct::done::%loop-index%} is not set:
                set {_w} to true
    return {_w}

# Сколько алмазов у игрока в рюкзаке
function ct_diamonds(p: player) :: number:
    return number of diamond in {_p}'s inventory

# Псевдоним: и заказчик, и исполнитель видят друг друга только под ним.
# Настоящий ник остаётся в переменной и в консольном логе — его поднимает
# Суд, если дело дойдёт до иска. Псевдоним постоянный у игрока, чтобы
# репутация исполнителя копилась, а личность — нет.
function ct_alias(name: text) :: text:
    if {ct::alias::%{_name}%} is not set:
        set {_words::*} to "Ворон", "Тень", "Уголь", "Пепел", "Крюк", "Сталь", "Туман", "Гвоздь", "Клык", "Север", "Полынь" and "Кремень"
        set {_w} to random element out of {_words::*}
        set {_n} to random integer between 10 and 99
        set {ct::alias::%{_name}%} to "%{_w}%-%{_n}%"
    return {ct::alias::%{_name}%}

# Голова-доказательство: голова жертвы с номером контракта в первой строке
# лора. Номер читается обратно (line 1 of lore, как у артефактов), поэтому
# подделать выплату чужой головой нельзя — при передаче сверяются и номер, и
# исполнитель, и заказчик.
# Репутация псевдонима.
#
# В УК 5.6 и в комментарии к ct_alias написано «репутация копится
# у псевдонима, ответственность остаётся на человеке» — но копить было
# нечему: счётчиков не существовало, и «Ворон-42» ничем не отличался от
# «Пепел-13». Теперь считаются две вещи: сколько контрактов ВЗЯТО и сколько
# ДОВЕДЕНО до расчёта.
#
# ⚠ Счётчики лежат на НИКЕ, а показываются под псевдонимом. Иначе репутацию
# нельзя было бы вести вообще: псевдоним по замыслу постоянный, но выдаётся
# функцией, а не хранится игроком.
#
# ⚠ Отозванный заказчиком и аннулированный Судом контракт в «исполнено»
# не идут: засчитывается только расчёт головой или решение Суда о выплате
# исполнителю.
function ct_rep_taken(name: text) :: number:
    if {ct::rep::taken::%{_name}%} is not set:
        return 0
    return {ct::rep::taken::%{_name}%}

function ct_rep_done(name: text) :: number:
    if {ct::rep::done::%{_name}%} is not set:
        return 0
    return {ct::rep::done::%{_name}%}

# Короткая подпись исполнителя для доски: «Ворон-42 · 5 из 7».
function ct_rep_tag(name: text) :: text:
    set {_d} to ct_rep_done({_name})
    set {_t} to ct_rep_taken({_name})
    if {_t} is 0:
        return "%ct_alias({_name})% &8· новичок"
    return "%ct_alias({_name})% &8· %{_d}% из %{_t}%"

function ct_head(id: text, victim: text) :: item:
    set {_i} to 1 of player head
    set skull owner of {_i} to {_victim} parsed as offline player
    set custom model data of {_i} to {@head_cmd}
    set name of {_i} to "&4&lГолова: %{_victim}%"
    set lore of {_i} to "&8Контракт №%{_id}%" and "&7Доказательство исполнения." and "&7Отдай заказчику: встань рядом и ПКМ по нему." and "&8Без заказчика — просто трофей."
    return {_i}

function ct_head_id(i: item) :: text:
    if {_i} is air:
        return ""
    if custom model data of {_i} is not {@head_cmd}:
        return ""
    set {_line} to uncoloured (line 1 of lore of {_i})
    # строка вида «Контракт №7» -> «7»
    set {_parts::*} to {_line} split at "№"
    if {_parts::2} is set:
        return {_parts::2}
    return ""

# ---------------------------------------------------------------------------
# Команды
# ---------------------------------------------------------------------------

command /contract [<text>] [<text>] [<integer>]:
    description: Контракты на устранение
    usage: /contract board | new <ник> <алмазов> | take <id> | drop <id> | mine | mail
    trigger:
        if arg-1 is not set:
            send "{@prefix}&7/contract board &8— доска открытых контрактов" to player
            send "{@prefix}&7/contract new <ник> <алмазов> &8— заказать" to player
            send "{@prefix}&7/contract take <id> &8— взять исполнение" to player
            send "{@prefix}&7/contract drop <id> &8— отозвать свой заказ" to player
            send "{@prefix}&7/contract mine &8— мои заказы и взятые" to player
            send "{@prefix}&7/contract rep &8— репутация псевдонимов подполья" to player
            send "{@prefix}&8Награда приходит не за смерть, а за ГОЛОВУ:" to player
            send "{@prefix}&8исполнитель несёт голову заказчику и ПКМ по нему (в Личине)" to player
            send "{@prefix}&8или шлёт её анонимно почтой: &7/contract mail&8 с головой в руке." to player
            if player has permission "{@admin}":
                send "{@prefix}&c/contract settle <id> &8— выдать награду исполнителю (голова потеряна)" to player
                send "{@prefix}&c/contract void <id> &8— вернуть депозит заказчику (спор Суда)" to player
            send "{@prefix}&4Убийство вне контракта — статья УК 1.4." to player
            stop

        if arg-1 is "board":
            set {_n} to 0
            loop {ct::target::*}:
                set {_id} to loop-index
                set {_t} to loop-value
                set {_p} to {ct::price::%{_id}%}
                # ⚠ Заказ невидим для самой цели. Анонимны все трое: заказчик
                # не показан никому, исполнитель идёт под псевдонимом, а
                # жертва вообще не знает, что заказ есть. Предупреждённая
                # цель не выйдет из города, и доска превратилась бы в систему
                # оповещения об опасности.
                if {_t} is not "%player%":
                    if {ct::taker::%{_id}%} is not set:
                        add 1 to {_n}
                        send "&7 №&f%{_id}%&7: цель &c%{_t}%&7, награда &b%{_p}%💎 &8— свободен" to player
                        send "&8   взять: &b/contract take %{_id}%" to player
                    else if {ct::done::%{_id}%} is set:
                        add 1 to {_n}
                        send "&8 №%{_id}%: цель %{_t}% мёртв — ждёт передачи головы заказчику" to player
                    else:
                        add 1 to {_n}
                        set {_who} to ct_rep_tag({ct::taker::%{_id}%})
                        send "&8 №%{_id}%: цель %{_t}%, награда %{_p}%💎 — взят: %{_who}%" to player
            if {_n} is 0:
                send "{@prefix}&7Открытых контрактов нет." to player
            else:
                send "{@prefix}&8Заказчик в контракте не указан — его знает только Суд." to player
            stop

        if arg-1 is "new":
            if arg-2 is not set:
                send "{@prefix}&cУкажи ник цели." to player
                stop
            if arg-3 is not set:
                send "{@prefix}&cУкажи награду в алмазах (минимум {@minprice})." to player
                stop
            if arg-3 < {@minprice}:
                send "{@prefix}&cМинимальная награда — &f{@minprice}💎&c." to player
                stop
            if arg-2 is "%player%":
                send "{@prefix}&cНа себя контракт не оформляют." to player
                stop
            # Повторный заказ той же цели — не раньше, чем через сутки после
            # исполнения прошлого: иначе контракт превращается в травлю, и
            # человека убивают по кругу на каждом выходе из дома.
            # ⚠ Отказ нейтральный и не говорит, что цель недавно убита по
            # заказу: заказчик не должен узнавать о чужих контрактах.
            set {_tk} to arg-2 in lowercase
            set {_now} to unix timestamp of now
            if {ct::last::%{_tk}%} is set:
                if ({_now} - {ct::last::%{_tk}%}) < {@repeat}:
                    send "{@prefix}&cНа этого человека сейчас заказы не принимают. Попробуй позже." to player
                    stop
            if ct_diamonds(player) < arg-3:
                send "{@prefix}&cНужно &f%arg-3%💎&c на руках: депозит платится вперёд." to player
                stop
            remove arg-3 of diamond from player's inventory
            add 1 to {ct::id}
            set {_id} to "%{ct::id}%"
            set {ct::target::%{_id}%} to arg-2
            set {ct::owner::%{_id}%} to "%player%"
            set {ct::price::%{_id}%} to arg-3
            set {ct::made::%{_id}%} to unix timestamp of now
            delete {ct::taker::%{_id}%}
            send "{@prefix}&aКонтракт №&f%{_id}%&a оформлен: цель &c%arg-2%&a, депозит &b%arg-3%💎&a." to player
            send "{@prefix}&7Отозвать и забрать алмазы: &b/contract drop %{_id}%" to player
            send "{@prefix}&4Если Суд докажет заказ — отвечать будешь вместе с исполнителем." to player
            send "[КОНТРАКТ] №%{_id}%: %player% заказал %arg-2% за %arg-3% алмазов" to console
            stop

        if arg-1 is "take":
            if arg-2 is not set:
                send "{@prefix}&cУкажи номер." to player
                stop
            if ct_open(arg-2) is false:
                send "{@prefix}&cТакого контракта нет." to player
                stop
            if {ct::taker::%arg-2%} is set:
                send "{@prefix}&7Его уже взял другой." to player
                stop
            if {ct::owner::%arg-2%} is "%player%":
                send "{@prefix}&cСвой заказ исполнять нельзя." to player
                stop
            # ⚠ Цели отвечаем ровно тем же, что и на несуществующий номер.
            # Прежняя строка «Это контракт на тебя. Беги.» была готовым
            # детектором: перебрав номера, любой узнавал, заказан ли он.
            if {ct::target::%arg-2%} is "%player%":
                send "{@prefix}&cТакого контракта нет." to player
                stop
            set {ct::taker::%arg-2%} to "%player%"
            add 1 to {ct::rep::taken::%player%}
            set {_alias} to ct_alias("%player%")
            send "{@prefix}&cКонтракт №&f%arg-2%&c твой. Цель: &f%{ct::target::%arg-2%}%&c." to player
            send "{@prefix}&7Награда придёт, когда цель погибнет от твоей руки." to player
            send "{@prefix}&8Ты проходишь как &f%{_alias}%&8 — ника не видит никто, кроме Суда." to player
            set {_owner} to {ct::owner::%arg-2%} parsed as player
            if {_owner} is set:
                send "{@prefix}&7Контракт №&f%arg-2%&7 взят в работу. Исполнитель: &f%{_alias}%&7." to {_owner}
            send "[КОНТРАКТ] №%arg-2% взял %player% (псевдоним %{_alias}%)" to console
            stop

        if arg-1 is "drop":
            if arg-2 is not set:
                send "{@prefix}&cУкажи номер." to player
                stop
            if ct_open(arg-2) is false:
                send "{@prefix}&cТакого контракта нет." to player
                stop
            if {ct::owner::%arg-2%} is not "%player%":
                send "{@prefix}&cЭто не твой заказ." to player
                stop
            if {ct::taker::%arg-2%} is set:
                send "{@prefix}&cЕго уже взяли в работу — отозвать нельзя." to player
                stop
            set {_back} to {ct::price::%arg-2%}
            give {_back} of diamond to player
            ct_close(arg-2)
            send "{@prefix}&aКонтракт отозван, &b%{_back}%💎&a возвращены." to player
            stop

        if arg-1 is "mine":
            set {_n} to 0
            loop {ct::target::*}:
                set {_id} to loop-index
                if {ct::owner::%{_id}%} is "%player%":
                    add 1 to {_n}
                    if {ct::done::%{_id}%} is set:
                        send "&7 №&f%{_id}%&7 мой заказ: цель &c%loop-value%&7 мёртв — жди голову от исполнителя" to player
                    else:
                        send "&7 №&f%{_id}%&7 мой заказ: цель &c%loop-value%&7, депозит &b%{ct::price::%{_id}%}%💎" to player
                else if {ct::taker::%{_id}%} is "%player%":
                    add 1 to {_n}
                    if {ct::mailed::%{_id}%} is set:
                        send "&7 №&f%{_id}%&7 взят мной: голова едет почтой, расчёт при вручении" to player
                    else if {ct::done::%{_id}%} is set:
                        send "&7 №&f%{_id}%&7 взят мной: цель &c%loop-value%&7 мёртв — отнеси голову заказчику" to player
                    else:
                        send "&7 №&f%{_id}%&7 взят мной: цель &c%loop-value%&7, награда &b%{ct::price::%{_id}%}%💎" to player
            if {_n} is 0:
                send "{@prefix}&7Ни заказов, ни взятых контрактов." to player
            else:
                set {_me} to "%player%"
                set {_alias} to ct_alias({_me})
                # ⚠ Вызов функции с вложенным %player% внутри строки Skript
                # не разбирает: он отдаёт всю строку выражению региона и
                # падает с «Region ... could not be found» (та же грабля, что
                # в spear_no_cooldown.sk). Считаем заранее в переменные.
                set {_rt} to ct_rep_taken({_me})
                set {_rd} to ct_rep_done({_me})
                send "{@prefix}&8Твой псевдоним в этих делах: &f%{_alias}%" to player
                send "&8 Репутация: взято &f%{_rt}%&8, исполнено &f%{_rd}%" to player
            stop

        # Доска репутации: только псевдонимы. Смысл ровно в том, чтобы имя
        # исполнителя что-то значило, а личность при этом не раскрывалась —
        # УК 5.6. Перебор идёт по {ct::rep::taken::*}: у ветки без
        # собственного значения loop ничего не вернул бы.
        if arg-1 is "rep":
            set {_n} to 0
            send "{@prefix}&7Репутация подполья:" to player
            loop {ct::rep::taken::*}:
                add 1 to {_n}
                set {_who} to loop-index
                send "&8 %ct_alias({_who})%&8: взято &7%loop-value%&8, исполнено &7%ct_rep_done({_who})%" to player
            if {_n} is 0:
                send "&7 Пока никто не брал контрактов." to player
            else:
                send "&8 Настоящие имена знает только Суд (УК 5.6)." to player
            stop

        # Голова заказчику — анонимной посылкой. Адрес берётся из контракта:
        # исполнитель заказчика не знает, и почта его не выдаёт ни здесь,
        # ни в /mailbox (mail.sk). Номер контракта читается с головы в руке.
        if arg-1 is "mail":
            set {_id} to ct_head_id(player's tool)
            if {_id} is "":
                send "{@prefix}&cВозьми в главную руку голову-доказательство." to player
                stop
            if ct_open({_id}) is false:
                send "{@prefix}&cЭтот контракт уже закрыт. Голова — просто трофей." to player
                stop
            if {ct::done::%{_id}%} is not "%player%":
                send "{@prefix}&cЭто не твоя голова по контракту." to player
                stop
            if {ct::mailed::%{_id}%} is set:
                send "{@prefix}&cГолова по контракту №&f%{_id}%&c уже в пути." to player
                stop
            set {_r} to tr_pay(player, {@mail_price})
            if {_r} is not "ok":
                send "{@prefix}%{_r}%" to player
                send "{@prefix}&7Марка — &b{@mail_price}💎&7, идёт в Казну Спавна." to player
                stop
            # Сначала изъять, потом отправить: иначе голову успеют и
            # отправить, и донести лично — две выплаты за одну смерть.
            set {_head} to player's tool
            set player's tool to air
            set {_me} to "%player%"
            set {_alias} to ct_alias({_me})
            set {_mid} to mail_anon_parcel({ct::owner::%{_id}%}, {_me}, {_alias}, {_head}, {_id})
            set {ct::mailed::%{_id}%} to {_mid}
            send "{@prefix}&7Голова по контракту №&f%{_id}%&7 ушла почтой. Курьер идёт 20 минут." to player
            send "{@prefix}&8Отправитель в посылке — &f%{_alias}%&8. Награда придёт при вручении," to player
            send "{@prefix}&8а если тебя не будет в сети — при входе." to player
            stop

        # Аварийный расчёт Суда, когда голова потеряна (исполнитель погиб с
        # ней, она сгорела). Без этого депозит завис бы в эскроу навсегда:
        # settle отдаёт награду исполнителю, void возвращает депозит заказчику.
        # Кто прав — решает Суд по логам, отсюда право coreprotect.rollback.
        if arg-1 is "settle":
            if player does not have permission "{@admin}":
                send "{@prefix}&cЭто команда Суда." to player
                stop
            if arg-2 is not set:
                send "{@prefix}&cУкажи номер контракта." to player
                stop
            if ct_open(arg-2) is false:
                send "{@prefix}&cТакого контракта нет." to player
                stop
            if {ct::done::%arg-2%} is not set:
                send "{@prefix}&cЦель по этому контракту ещё жива — расчёта нет." to player
                stop
            set {_taker} to {ct::done::%arg-2%} parsed as player
            set {_price} to {ct::price::%arg-2%}
            if {_taker} is set:
                give {_price} of diamond to {_taker}
                add 1 to {ct::rep::done::%{_taker}%}
                send "{@prefix}&aСуд закрыл контракт №&f%arg-2%&a: награда &b%{_price}%💎&a выдана." to {_taker}
            else:
                send "{@prefix}&cИсполнитель не в сети — награду выдать некому. Дождись его." to player
                stop
            send "{@prefix}&aКонтракт №&f%arg-2%&a закрыт Судом (голова потеряна)." to player
            send "[КОНТРАКТ] №%arg-2% закрыт Судом (settle) администратором %player%" to console
            ct_close(arg-2)
            stop

        if arg-1 is "void":
            if player does not have permission "{@admin}":
                send "{@prefix}&cЭто команда Суда." to player
                stop
            if arg-2 is not set:
                send "{@prefix}&cУкажи номер контракта." to player
                stop
            if ct_open(arg-2) is false:
                send "{@prefix}&cТакого контракта нет." to player
                stop
            set {_owner} to {ct::owner::%arg-2%} parsed as player
            set {_price} to {ct::price::%arg-2%}
            if {_owner} is set:
                give {_price} of diamond to {_owner}
                send "{@prefix}&aСуд аннулировал контракт: депозит &b%{_price}%💎&a возвращён." to {_owner}
            else:
                send "{@prefix}&cЗаказчик не в сети — депозит вернуть некому. Дождись его." to player
                stop
            send "{@prefix}&aКонтракт №&f%arg-2%&a аннулирован Судом." to player
            send "[КОНТРАКТ] №%arg-2% аннулирован Судом (void) администратором %player%" to console
            ct_close(arg-2)
            stop

        send "{@prefix}&cНеизвестное действие. Смотри &b/contract" to player

function ct_close(id: text):
    delete {ct::target::%{_id}%}
    delete {ct::owner::%{_id}%}
    delete {ct::price::%{_id}%}
    delete {ct::taker::%{_id}%}
    delete {ct::made::%{_id}%}
    delete {ct::done::%{_id}%}
    delete {ct::mailed::%{_id}%}

# ---------------------------------------------------------------------------
# Смерть: расчёт по контракту и свидетели
# ---------------------------------------------------------------------------

on death of player:
    set {_dead} to "%victim%"
    set {_killer} to attacker
    if {_killer} is a player:
        set {_kname} to "%{_killer}%"
        set {_paid} to false

        # Цель убита исполнителем: контракт НЕ закрывается и деньги НЕ
        # выдаются. Исполнитель получает голову-доказательство и несёт её
        # заказчику — выплата ждёт передачи (см. `on right click on player`).
        loop {ct::target::*}:
            set {_id} to loop-index
            if loop-value is {_dead}:
                if {ct::taker::%{_id}%} is {_kname}:
                    if {ct::done::%{_id}%} is not set:
                        set {ct::done::%{_id}%} to {_kname}
                        set {_dk} to {_dead} in lowercase
                        set {ct::last::%{_dk}%} to unix timestamp of now
                        give ct_head({_id}, {_dead}) to {_killer}
                        send "{@prefix}&cЦель по контракту №&f%{_id}%&c мертва." to {_killer}
                        send "{@prefix}&7Награда &b%{ct::price::%{_id}%}%💎&7 ждёт передачи головы." to {_killer}
                        send "{@prefix}&7Лично: встань рядом с заказчиком и ПКМ по нему — в Личине." to {_killer}
                        send "{@prefix}&7Или анонимно почтой: &b/contract mail&7 с головой в руке." to {_killer}
                        set {_owner} to {ct::owner::%{_id}%} parsed as player
                        if {_owner} is set:
                            set {_alias} to ct_alias({_kname})
                            send "{@prefix}&7Контракт №&f%{_id}%&7 исполнен: &c%{_dead}%&7 мёртв." to {_owner}
                            send "{@prefix}&8Исполнитель &f%{_alias}%&8 принесёт голову — тогда депозит уйдёт ему." to {_owner}
                        send "[КОНТРАКТ] №%{_id}% исполнен (голова выдана): %{_kname}% убил %{_dead}%" to console
                        set {_paid} to true

        # свидетели: все, кто был рядом и это не убийца с жертвой
        set {_seen} to 0
        loop players in radius {@witness} around victim:
            if "%loop-player%" is not {_dead}:
                if "%loop-player%" is not {_kname}:
                    add 1 to {_seen}
                    send "{@line}" to loop-player
                    send "{@prefix}&cТы видел убийство." to loop-player
                    send "&7%{_kname}% &7убил &f%{_dead}%&7." to loop-player
                    # ⚠ Причину в команде писать бессмысленно: AdvancedReports
                    # берёт только ник, остальное спрашивает своим окном.
                    send "&7Показания в Суд: &b/report %{_kname}%" to loop-player
                    send "&8   или головами, без набора ника: &b/witness" to loop-player
                    send "&8   Причину и подробности спросит окно жалобы." to loop-player
                    send "&8   Молчание — твоё право, но и соучастие бывает разным." to loop-player
                    send "{@line}" to loop-player
        if {_paid} is true:
            if {_seen} > 0:
                send "{@prefix}&4Тебя видели: свидетелей — &f%{_seen}%&4." to {_killer}
            else:
                send "{@prefix}&8Свидетелей не было. Пока." to {_killer}
        else:
            if {_seen} > 0:
                send "{@prefix}&4Убийство вне контракта, свидетелей: &f%{_seen}%&4. Статья УК 1.4." to {_killer}

# ---------------------------------------------------------------------------
# Передача головы заказчику — расчёт по контракту
# ---------------------------------------------------------------------------
#
# Исполнитель встаёт рядом с заказчиком и ПКМ по нему с головой в руке.
# Только здесь депозит переходит из «эскроу» в руки исполнителя.
#
# ⚠ Сверяются три вещи: номер контракта из головы, что кликнувший — тот
# самый исполнитель, и что цель клика — тот самый заказчик. Голова, украденная
# или переданная третьему, выплату не откроет: чужой держатель не пройдёт
# проверку исполнителя, а Суд поднимет по логу, кто на самом деле убивал.
on right click on player:
    set {_id} to ct_head_id(player's tool)
    if {_id} is not "":
        cancel event
        set {_target} to clicked entity
        if ct_open({_id}) is false:
            send "{@prefix}&cЭтот контракт уже закрыт. Голова — просто трофей." to player
            stop
        if {ct::done::%{_id}%} is not "%player%":
            send "{@prefix}&cЭто не твоя голова по контракту." to player
            stop
        if {ct::owner::%{_id}%} is not "%{_target}%":
            send "{@prefix}&7Это не заказчик контракта №&f%{_id}%&7." to player
            send "&8   Голову ждёт тот, кто оформил заказ." to player
            stop
        # ⚠ Передача из рук в руки — только в Личине. Заказчик видит
        # исполнителя в лицо, и без чужого скина псевдоним «Ворон-42» стоил
        # бы ровно до первой встречи. Не надел сам — надеваем и просим
        # кликнуть ещё раз: заказчик должен увидеть уже чужой скин, а не то,
        # как свой сменяется на чужой в момент расчёта.
        if sh_is_on(player) is false:
            sh_put_on(player)
            send "{@prefix}&8Личина надета: голову передают только в ней." to player
            send "{@prefix}&7Кликни по заказчику ещё раз." to player
            stop
        # заказчик подтверждён — расчёт
        set {_price} to {ct::price::%{_id}%}
        remove 1 of player's tool from player
        give {_price} of diamond to player
        add 1 to {ct::rep::done::%player%}
        send "{@prefix}&aГолова принята. Контракт №&f%{_id}%&a закрыт." to player
        send "{@prefix}&aНаграда: &b%{_price}%💎&a." to player
        set {_me} to "%player%"
        set {_alias} to ct_alias({_me})
        send "{@prefix}&7%{_alias}%&7 передал тебе голову &c%{ct::target::%{_id}%}%&7. Дело сделано." to {_target}
        send "{@prefix}&8Депозит &b%{_price}%💎&8 ушёл исполнителю." to {_target}
        send "[КОНТРАКТ] №%{_id}% оплачен: %player% передал голову заказчику %{_target}%" to console
        ct_close({_id})

# ---------------------------------------------------------------------------
# Голова-доказательство теряет силу вместе с CustomModelData
# ---------------------------------------------------------------------------
#
# Поставленная на землю голова становится ванильным блоком и теряет метку —
# то есть перестаёт быть доказательством. Ставить её запрещаем: иначе
# исполнитель «положил и поднял», а выплата зависла бы навсегда (та же
# логика, что запрет ставить sugar_cane в nirvana.sk).
on place of player head:
    if ct_head_id(player's tool) is not "":
        cancel event
        send "{@prefix}&cГолову-доказательство не ставят — отнеси её заказчику." to player

# ---------------------------------------------------------------------------
# Голова пришла почтой — расчёт (вызывает mail.sk при вручении)
# ---------------------------------------------------------------------------
#
# ⚠ Сверяется то же, что при личной передаче: контракт открыт и голову снял
# именно этот исполнитель. Закрыл Суд контракт, пока голова ехала (settle
# или void), — она приходит трофеем, второй выплаты нет.
function ct_mail_paid(id: text, taker: text):
    if ct_open({_id}) is true:
        if {ct::done::%{_id}%} is {_taker}:
            set {_price} to {ct::price::%{_id}%}
            set {_owner} to {ct::owner::%{_id}%} parsed as player
            if {_owner} is set:
                send "{@prefix}&7Контракт №&f%{_id}%&7 закрыт. Депозит &b%{_price}%💎&7 ушёл исполнителю." to {_owner}
            ct_pay_taker({_taker}, {_price}, {_id})
            add 1 to {ct::rep::done::%{_taker}%}
            send "[КОНТРАКТ] №%{_id}% оплачен: %{_taker}% прислал голову почтой заказчику %{ct::owner::%{_id}%}%" to console
            ct_close({_id})

# Выдать награду исполнителю: в сети — в руки, нет — в долг до входа
# (тот же приём, что у почты и аукциона: вещь не теряется из-за оффлайна).
function ct_pay_taker(taker: text, price: number, id: text):
    set {_p} to {_taker} parsed as player
    if {_p} is set:
        give {_price} of diamond to {_p}
        send "{@prefix}&aГолова по контракту №&f%{_id}%&a вручена. Награда: &b%{_price}%💎&a." to {_p}
    else:
        add {_price} to {ct::owe::%{_taker}%}

on join:
    wait 5 seconds
    set {_me} to "%player%"
    if {ct::owe::%{_me}%} is set:
        set {_n} to {ct::owe::%{_me}%}
        delete {ct::owe::%{_me}%}
        give {_n} of diamond to player
        send "{@prefix}&aПока тебя не было, голову вручили. Награда: &b%{_n}%💎&a." to player
